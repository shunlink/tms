# Maps & routing (add to your `.env`)
#
# Provider: osm (free OSM embed tiles) | google | mapbox
MAPS_PROVIDER=google
NEXT_PUBLIC_MAPS_PROVIDER=google
#
# Google — enable Maps Embed API + Directions API; restrict keys in GCP console
GOOGLE_MAPS_API_KEY=your_server_key
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=your_browser_restricted_key
#
# Mapbox (optional alternative)
# MAPS_PROVIDER=mapbox
# MAPBOX_ACCESS_TOKEN=your_server_token
# NEXT_PUBLIC_MAPBOX_ACCESS_TOKEN=your_public_token
#
# Optional custom raster tiles (Leaflet / future map UI)
# NEXT_PUBLIC_MAP_TILE_URL=https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png
#
# Docker Compose also needs (if not already in .env):
# POSTGRES_USER=tms
# POSTGRES_PASSWORD=choose_a_strong_password
# POSTGRES_DB=tms
