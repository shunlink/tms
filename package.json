{
  "name": "tms-aggregator",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "node scripts/check-whatsapp-tunnel.mjs && next dev",
    "tunnel": "node scripts/tunnel.mjs",
    "whatsapp:simulate": "node scripts/simulate-whatsapp-quote.mjs",
    "whatsapp:check": "node scripts/whatsapp-infra-check.mjs",
    "build": "prisma generate && next build",
    "start": "next start",
    "lint": "next lint",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "docs:pdf": "node scripts/gen-architecture-pdf.mjs",
    "docs:platform-ease-pdf": "node scripts/gen-platform-ease-pdf.mjs",
    "docs:advanced-ai-docx": "node scripts/gen-advanced-ai-docx.mjs",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:migrate:deploy": "prisma migrate deploy",
    "db:reset": "prisma migrate reset --force && tsx prisma/seed.ts",
    "db:studio": "prisma studio",
    "db:seed": "tsx prisma/seed.ts",
    "db:sync-permissions": "tsx scripts/sync-permissions.ts",
    "worker:email": "tsx scripts/email-worker.ts",
    "worker:payment": "tsx scripts/payment-worker.ts",
    "worker:sla": "tsx scripts/sla-escalation-worker.ts",
    "finance:reconcile": "tsx scripts/reconcile-vendor-payables.ts",
    "accounting:init": "tsx scripts/init-accounting.ts",
    "bidding:smoke": "bash scripts/bidding-integration-smoke.sh",
    "package:deploy": "powershell -ExecutionPolicy Bypass -File scripts/package-deploy.ps1",
    "docker:dev": "docker compose -f docker-compose.example.yml up -d",
    "docker:dev:down": "docker compose -f docker-compose.example.yml down",
    "docker:staging": "docker compose -f docker-compose.staging.yml --env-file .env.staging up -d --build",
    "docker:staging:down": "docker compose -f docker-compose.staging.yml down",
    "docker:staging:logs": "docker compose -f docker-compose.staging.yml logs -f app worker-email"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/utilities": "^3.2.2",
    "@prisma/client": "^5.16.0",
    "@radix-ui/react-dialog": "^1.1.1",
    "@radix-ui/react-dropdown-menu": "^2.1.1",
    "@radix-ui/react-select": "^2.1.1",
    "@radix-ui/react-tabs": "^1.1.0",
    "@radix-ui/react-toast": "^1.2.1",
    "bcryptjs": "^2.4.3",
    "bullmq": "^6.3.11",
    "class-variance-authority": "^0.7.0",
    "clsx": "^2.1.1",
    "ioredis": "^5.11.1",
    "lucide-react": "^0.400.0",
    "next": "14.2.35",
    "next-auth": "^4.24.7",
    "qrcode": "^1.5.4",
    "qrcode.react": "^4.2.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "recharts": "^2.12.7",
    "resend": "^6.32.1",
    "tailwind-merge": "^2.3.0",
    "tailwindcss-animate": "^1.0.7",
    "zod": "^3.25.76",
    "puppeteer-core": "^25.12.0"
  },
  "overrides": {
    "esbuild": "^0.25.0",
    "glob": "^10.4.6",
    "minimatch": "^9.0.5",
    "postcss": "^8.5.31",
    "tinypool": "^2.2.0"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^20.14.9",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "autoprefixer": "^10.4.19",
    "docx": "^9.13.0",
    "eslint": "^8.57.0",
    "eslint-config-next": "14.2.35",
    "marked": "^18.0.14",
    "postcss": "^8.5.31",
    "prisma": "^5.16.0",
    "tailwindcss": "^3.4.19",
    "tsx": "^4.16.0",
    "typescript": "^5.5.3",
    "vitest": "^3.2.7"
  }
}
