{
  "name": "tms-aggregator",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "node scripts/check-whatsapp-tunnel.mjs && next dev",
    "tunnel": "node scripts/tunnel.mjs",
    "whatsapp:simulate": "node scripts/simulate-whatsapp-quote.mjs",
    "whatsapp:check": "node scripts/whatsapp-infra-check.mjs",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "docs:pdf": "node scripts/gen-architecture-pdf.mjs",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:migrate:deploy": "prisma migrate deploy",
    "db:reset": "prisma migrate reset --force && tsx prisma/seed.ts",
    "db:studio": "prisma studio",
    "db:seed": "tsx prisma/seed.ts",
    "worker:email": "tsx scripts/email-worker.ts",
    "worker:payment": "tsx scripts/payment-worker.ts",
    "finance:reconcile": "tsx scripts/reconcile-vendor-payables.ts",
    "accounting:init": "tsx scripts/init-accounting.ts",
    "bidding:smoke": "bash scripts/bidding-integration-smoke.sh"
  },
  "dependencies": {
    "@prisma/client": "^5.16.0",
    "@radix-ui/react-dialog": "^1.1.1",
    "@radix-ui/react-dropdown-menu": "^2.1.1",
    "@radix-ui/react-select": "^2.1.1",
    "@radix-ui/react-tabs": "^1.1.0",
    "@radix-ui/react-toast": "^1.2.1",
    "bcryptjs": "^2.4.3",
    "bullmq": "^6.3.11",
    "class-variance-authority": "^0.7.0",
    "clsx": "^2.1.1",
    "ioredis": "^5.11.1",
    "lucide-react": "^0.400.0",
    "next": "14.2.5",
    "next-auth": "^4.24.7",
    "qrcode.react": "^4.2.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "recharts": "^2.12.7",
    "resend": "^6.32.1",
    "tailwind-merge": "^2.3.0",
    "tailwindcss-animate": "^1.0.7",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^20.14.9",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "autoprefixer": "^10.4.19",
    "eslint": "^8.57.0",
    "eslint-config-next": "14.2.5",
    "marked": "^18.0.14",
    "postcss": "^8.4.39",
    "prisma": "^5.16.0",
    "puppeteer-core": "^25.12.0",
    "tailwindcss": "^3.4.4",
    "tsx": "^4.16.0",
    "typescript": "^5.5.3",
    "vitest": "^2.0.5"
  }
}
