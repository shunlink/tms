# Copy to .env.staging on the staging server (never commit .env.staging).
#   cp .env.staging.example .env.staging
#
# Must match POSTGRES_* in docker-compose.staging.yml (user tms_staging, db tms_staging).
# POSTGRES_PASSWORD here MUST be identical in DATABASE_URL and DIRECT_URL.
# Inside Docker use host `db` (not localhost). URLs without surrounding quotes.

# --- PostgreSQL (staging db container + Prisma) ---
POSTGRES_USER=tms_staging
POSTGRES_PASSWORD=tms_staging_change_me
POSTGRES_DB=tms_staging
DATABASE_URL=postgresql://tms_staging:tms_staging_change_me@db:5432/tms_staging?schema=public
DIRECT_URL=postgresql://tms_staging:tms_staging_change_me@db:5432/tms_staging?schema=public

# --- Redis (compose sets redis://redis:6379 on app/worker) ---
REDIS_URL=redis://redis:6379

# --- Public staging URL (HTTPS via reverse proxy -> 127.0.0.1:3001) ---
NEXTAUTH_URL=https://staging.tms.shunlink.in
PUBLIC_BASE_URL=https://staging.tms.shunlink.in
NEXTAUTH_SECRET=generate-with-openssl-rand-base64-32-staging

# --- Email (Resend) ---
RESEND_API_KEY=re_staging_xxxxxxxx
MAIL_FROM=TMS Staging <staging-alerts@shunlink.in>
EMAIL_WORKER_CONCURRENCY=3

# --- Notifications: console avoids real WhatsApp/SMS during QA ---
NOTIFY_PROVIDER=console

# --- Document storage (isolated volume tms_staging_uploads) ---
STORAGE_DRIVER=local

# --- External verification ---
INTEGRATION_MODE=mock

# --- Perione E-Way Bill lite (GET getewaybill — no authenticate) ---
# EWAY_API_BASE_URL=https://staging.perione.in
# EWAY_API_STYLE=perione
# EWAY_CLIENT_ID=
# EWAY_CLIENT_SECRET=
# EWAY_EMAIL=
# EWAY_GSTIN=
# EWAY_IP_ADDRESS=0
# EWAY_GET_PATH=/ewaybillapi/v1.03/ewayapi/getewaybill

# --- Maps ---
MAPS_PROVIDER=nominatim

# --- Juspay (Hypercheckout + Payout) ---
# PAYMENT_GATEWAY_PROVIDER=juspay
# JUSPAY_API_KEY=
# JUSPAY_MERCHANT_ID=
# JUSPAY_PAYMENT_PAGE_CLIENT_ID=
# JUSPAY_API_BASE=https://sandbox.juspay.in
# JUSPAY_WEBHOOK_USERNAME=
# JUSPAY_WEBHOOK_PASSWORD=
# NEXT_PUBLIC_APP_URL=https://staging.tms.shunlink.in