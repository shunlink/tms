/// Singleton row (id = "default") — letterhead, tax IDs, and bank details for LR/invoices/vouchers.
model CompanySettings {
  id                   String   @id @default("default")
  companyName          String   @default("")
  logoPath             String   @default("brand/logo-light.svg")
  registeredAddress    String   @default("")
  gstin                String   @default("")
  pan                  String   @default("")
  defaultFreightGstPercent Decimal @default(18)
  accountsEmail        String   @default("")
  contactPhone         String   @default("")
  stateLabel           String   @default("")
  bankName             String   @default("")
  bankAccountNumber    String   @default("")
  bankBranch           String   @default("")
  bankIfsc             String   @default("")
  lrPrefix             String?
  invoicePrefix        String?
  requirementPrefix    String?
  complianceAlertsJson Json?
  updatedById          String?
  updatedAt            DateTime @updatedAt
}
